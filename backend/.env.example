# Copy this file to .env and fill in what you need.
# Gemini is used when GEMINI_API_KEY is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional: OpenAI is used only when Gemini is not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Replace with a long random value before deploying.
SECRET_KEY=dev-secret-change-me-in-production
# Encrypts user BYOK keys at rest. Set a long random value in production.
KEY_ENCRYPTION_KEY=
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_EMAILS=udita.chakraborty05@gmail.com,asmita.chakrab@gmail.com

# Production: use Postgres, secure cookies, and Redis for shared rate limits.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/copilot.db
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
REDIS_URL=
SENTRY_DSN=


